# Backend Specific Environment Variables
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database
POSTGRES_DB=phantomtrace
POSTGRES_USER=phantomtrace_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=jdbc:postgresql://localhost:5432/phantomtrace

# Security
# Required. Generate locally; never commit the generated value:
#   openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# AI Configuration (Groq / OpenAI-compatible API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Threat Intelligence
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
URLHAUS_API_KEY=your_urlhaus_api_key_here

# Storage
FILE_STORAGE_TYPE=local
FILE_STORAGE_UPLOAD_DIR=./uploads

# Demo Seed (optional; dev profile only — enables a demo analyst account)
PHANTOMTRACE_DEMO_SEED_ENABLED=false
PHANTOMTRACE_DEMO_SEED_PASSWORD=PhantomTrace2026!
