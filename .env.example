# ==============================================================================
# PhantomTrace Environment Variables (Template)
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=phantomtrace
POSTGRES_USER=phantomtrace_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/phantomtrace

# Spring Boot Backend Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Security & Authentication
# Required. Generate locally; never commit the generated value:
#   openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
PHANTOMTRACE_RATE_LIMIT_ENABLED=true

# AI Provider Configuration (Groq API / OpenAI-Compatible)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# External Threat Intelligence APIs
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
URLHAUS_API_KEY=your_urlhaus_api_key_here

# File Storage Configuration
FILE_STORAGE_TYPE=local
FILE_STORAGE_UPLOAD_DIR=./uploads
FILE_STORAGE_MAX_FILE_SIZE_MB=25

# Demo Seed (optional; dev profile only — enables a demo analyst account)
PHANTOMTRACE_DEMO_SEED_ENABLED=false
PHANTOMTRACE_DEMO_SEED_PASSWORD=PhantomTrace2026!

# Frontend Configuration (Public Vite Variables)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=PhantomTrace
VITE_APP_ENV=development
